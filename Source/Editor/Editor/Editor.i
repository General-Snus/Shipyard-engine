template<class T>
inline Matrix4x4<T> Matrix4x4<T>::Invert(const Matrix4x4<T>& m) {
	const T det = GetDeterminant(m);
	if(det == 0) {
		throw std::runtime_error("Matrix is singular and cannot be inverted.");
	}
	return (1 / det) * GetAdjugate(m);
}


