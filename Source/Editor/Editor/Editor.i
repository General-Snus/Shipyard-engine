	const Vector4<T> rzxyy = Vector4<T>(rhf.z,rhf.x,rhf.y,rhf.y);

	const Vector4<T> lzxyz = Vector4<T>(lhf.z,lhf.x,lhf.y,lhf.z);

	const Vector4<T> ryzxz = Vector4<T>(rhf.y,rhf.z,rhf.x,rhf.z);
	
