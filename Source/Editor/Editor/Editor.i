{
	switch (aMessage.message)
	{
	case 0x0233:
	{
		const auto hDrop = reinterpret_cast<HDROP>(aMessage.wParam);
		const UINT numFiles = DragQueryFileW(hDrop, 0xFFFFFFFF, nullptr,
			0); 
		WM_DroppedPath.clear();
		for (UINT i = 0; i < numFiles; i++)
		{
			const UINT filePathLength = DragQueryFileW(hDrop, i, nullptr, 0); 

			std::wstring filePath;
			filePath.resize(filePathLength + 1); 
			DragQueryFileW(hDrop, i, filePath.data(),
				filePathLength + 1); 
			WM_DroppedPath.emplace_back(filePath);
		}

		DragFinish(hDrop); 
		if (!WM_DroppedPath.empty())
		{
			m_Callbacks[EditorCallback::WM_DropFile].Invoke();
		}
		break;
	}
	case 0x0005:
		if (aMessage.wParam != 2 && aMessage.wParam != 0)
		{
			break;
		}
	case 0x0232:
	{
		
		for (const auto& viewport : m_Viewports)
		{
			viewport->ResolutionUpdate();
		}
		ServiceLocator::Instance().GetService<GPU>().ResizeBackbuffer(window->Resolution());
