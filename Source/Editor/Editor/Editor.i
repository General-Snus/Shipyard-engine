    {
        m_Exports.emplace_back(m_Strings.LocalCopy(exportName));
        m_numExports++;
    }
    void AddSubobject(const D3D12_STATE_SUBOBJECT& subobject)
    {
        m_Subobjects.emplace_back(&subobject);
        m_numSubobjects++;
