struct EventTime
{
    static const int64_t INVALID_TIMESTAMP = (int64_t)-1;

    int64_t start;
    int64_t finish;

    __forceinline void Start()
    {
        start = Optick::GetHighPrecisionTime();
    }
    __forceinline void Stop()
    {
        finish = Optick::GetHighPrecisionTime();
    }
    __forceinline bool IsValid() const
    {
        return start < finish && start != INVALID_TIMESTAMP && finish != INVALID_TIMESTAMP;
    }
};

struct EventData : public EventTime
{
    const EventDescription *description;

    bool operator<(const EventData &other) const
    {
        if (start != other.start)
            return start < other.start;

        
        return finish > other.finish;
    }
};

