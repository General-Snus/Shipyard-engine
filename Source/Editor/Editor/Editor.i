Vector3<T> operator*(const Quaternion<T>& aQuat,const Vector3<T>& v) {
	const Vector3<T> r = (aQuat.x,aQuat.y,aQuat.z);
	const T s = aQuat.w;

	return
		2.0f * r.Dot(v) * r
		+ (s * s - r.Dot(r)) * v
		+ 2.0f * s * r.Cross(v);
}

