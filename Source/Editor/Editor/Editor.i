	Scale(1,1) = std::pow(T(1.0f) / scaling.x,T(2.0f));
	Scale(2,2) = std::pow(T(1.0f) / scaling.y,T(2.0f));
	Scale(3,3) = std::pow(T(1.0f) / scaling.z,T(2.0f));

	return Transform * Rotation * Scale; 
}

template<class T>
inline T Matrix4x4<T>::GetDeterminant(const Matrix4x4<T>& aTransform) {
	const auto& m = aTransform; 

	
	auto det3x3 = [](T a,T b,T c,T d,T e,T f,T g,T h,T i) {
		return a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
		};

	T detM11 = det3x3(m(2,2),m(2,3),m(2,4),
		m(3,2),m(3,3),m(3,4),
		m(4,2),m(4,3),m(4,4));

	T detM12 = det3x3(m(2,1),m(2,3),m(2,4),
		m(3,1),m(3,3),m(3,4),
		m(4,1),m(4,3),m(4,4));

	T detM13 = det3x3(m(2,1),m(2,2),m(2,4),
		m(3,1),m(3,2),m(3,4),
		m(4,1),m(4,2),m(4,4));

	T detM14 = det3x3(
		m(2,1),m(2,2),m(2,3),
		m(3,1),m(3,2),m(3,3),
		m(4,1),m(4,2),m(4,3)
	);

	return m(1,1) * detM11 - m(1,2) * detM12 + m(1,3) * detM13 - m(1,4) * detM14;
}

