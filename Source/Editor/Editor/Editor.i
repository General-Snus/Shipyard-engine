RECT Editor::GetViewportRECT() const
{
	return ViewportRect;
}

Vector2<unsigned int> Editor::GetViewportResolution() const
{
	const RECT rect = GetViewportRECT();
	return Vector2<unsigned int>(rect.right - rect.left, rect.bottom - rect.top);
}
