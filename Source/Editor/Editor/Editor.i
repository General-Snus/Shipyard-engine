	if (ServiceLocator::Instance().GetService<InputManager>().IsKeyHeld(Keys::CONTROL) && ServiceLocator::Instance().GetService<InputManager>().IsKeyPressed(Keys::C))
	{
		Copy();
	}
	if (ServiceLocator::Instance().GetService<InputManager>().IsKeyHeld(Keys::CONTROL) && ServiceLocator::Instance().GetService<InputManager>().IsKeyPressed(Keys::V))
	{
		Paste();
	}

	if (ServiceLocator::Instance().GetService<InputManager>().IsKeyPressed(Keys::F10))
	{
		GetEngineResources().ClearUnused();
	}
	if (ServiceLocator::Instance().GetService<InputManager>().IsKeyPressed(Keys::F6))
	{
		static bool enabled = false;
		enabled = !enabled;
		ServiceLocator::Instance().GetService<Shipyard_PhysX>().ShowDrawLines(enabled);
	}

	

	gameState.Update(delta);
	GetRenderer().Update(delta);
	ServiceLocator::Instance().GetService<Shipyard_PhysX>().EndRead(delta);
}

