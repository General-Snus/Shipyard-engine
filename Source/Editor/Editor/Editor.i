	adj(4,1) = -det3x3(m(2,1),m(2,2),m(2,3),m(3,1),m(3,2),m(3,3),m(4,1),m(4,2),m(4,3));

	adj(1,2) = -det3x3(m(1,2),m(1,3),m(1,4),m(3,2),m(3,3),m(3,4),m(4,2),m(4,3),m(4,4));
